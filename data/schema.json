{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component-vocab/component.schema.json",
  "title": "Component",
  "description": "One component in the vocabulary. String fields ending in HTML content (description, htmlElement, captions, notes) hold trusted inline HTML copied from the pages.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "order", "status", "group", "description", "summary", "alsoKnownAs", "htmlElement", "elements", "wireframe", "thumbnail", "configOptions", "variants", "collections", "sectionOrder", "usageNotes", "legacyComparison", "related"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "order": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["stable", "draft", "retired"] },
    "group": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "alsoKnownAs": { "type": "string" },
    "htmlElement": { "type": "string" },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "required": { "enum": ["Yes", "No"] },
          "description": { "type": "string" }
        }
      }
    },
    "wireframe": { "type": "string", "pattern": "^wireframes/.+\\.svg$" },
    "thumbnail": { "type": "string", "pattern": "^wireframes/.+\\.svg$" },
    "configOptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["config", "options", "affectsLayout", "highlighted"],
        "properties": {
          "config": { "type": "string", "minLength": 1 },
          "options": { "type": "string" },
          "affectsLayout": { "type": "string", "minLength": 1 },
          "highlighted": { "type": "boolean" }
        }
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caption", "wireframe"],
        "properties": {
          "caption": { "type": "string" },
          "wireframe": { "type": "string", "pattern": "^wireframes/.+\\.svg$" }
        }
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "wireframe", "caption"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "wireframe": { "type": "string", "pattern": "^wireframes/.+\\.svg$" },
          "caption": { "type": ["string", "null"] }
        }
      }
    },
    "sectionOrder": {
      "type": "array",
      "items": { "enum": ["Elements", "Default Layout", "collection", "Configuration Options", "Layout Variations", "Usage Notes"] }
    },
    "usageNotes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "legacyComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap", "material", "ant", "apple", "shadcn"],
      "properties": {
        "bootstrap": { "type": "string" },
        "material": { "type": "string" },
        "ant": { "type": "string" },
        "apple": { "type": "string" },
        "shadcn": { "type": "string" }
      }
    },
    "related": { "type": "array", "items": { "type": "string" } }
  }
}
