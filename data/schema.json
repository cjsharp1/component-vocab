{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component-vocab/component.schema.json",
  "title": "Component",
  "description": "One component in the vocabulary. String fields ending in HTML content (description, htmlElement, captions, notes) hold trusted inline HTML copied from the pages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "order",
    "status",
    "group",
    "description",
    "summary",
    "htmlElement",
    "elements",
    "configOptions",
    "variants",
    "collections",
    "usageNotes",
    "aliases",
    "frameworkSource",
    "frameworkNames",
    "nativeHtml",
    "aria",
    "researchNote",
    "frameworkNotes",
    "parents",
    "children",
    "htmlOutline"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "stable",
        "draft",
        "retired"
      ]
    },
    "group": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 0,
      "description": "Required (non-empty) for stable components; drafts carry the research note or nothing."
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "htmlElement": {
      "type": "string"
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "required",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "enum": [
              "Yes",
              "No"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "wireframe": {
      "type": "string",
      "pattern": "^wireframes/.+\\.svg$"
    },
    "thumbnail": {
      "type": "string",
      "pattern": "^wireframes/.+\\.svg$"
    },
    "configOptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "config",
          "options",
          "affectsLayout",
          "highlighted"
        ],
        "properties": {
          "config": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "string"
          },
          "affectsLayout": {
            "type": "string",
            "minLength": 1
          },
          "highlighted": {
            "type": "boolean"
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caption",
          "wireframe"
        ],
        "properties": {
          "caption": {
            "type": "string"
          },
          "wireframe": {
            "type": "string",
            "pattern": "^wireframes/.+\\.svg$"
          }
        }
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "wireframe",
          "caption"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "wireframe": {
            "type": "string",
            "pattern": "^wireframes/.+\\.svg$"
          },
          "caption": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "usageNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Other names for this component, from the research list, the CSV and former page names."
    },
    "formerNames": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names this page had before a rename."
    },
    "absorbed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Retired pages folded into this one as variants."
    },
    "frameworkSource": {
      "enum": [
        "csv",
        "legacy",
        "none"
      ],
      "description": "csv: docs/research/framework-alignment.csv. legacy: the old page's 5-system row (component not in the CSV)."
    },
    "frameworkNames": {
      "type": "object",
      "description": "Per design system. match: same (CSV ●), alias (◐, a known alternative name), different (○, a related component under another name), none (—). The symbol meanings are inferred from the CSV; the research doc does not define them.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "match"
        ],
        "properties": {
          "match": {
            "enum": [
              "same",
              "alias",
              "different",
              "none"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nativeHtml": {
      "type": "string",
      "description": "Native HTML from research section 4 (backticks mark code)."
    },
    "aria": {
      "type": "string",
      "description": "APG pattern or ARIA role from research section 4."
    },
    "researchNote": {
      "type": "string",
      "description": "Note column from research section 4."
    },
    "frameworkNotes": {
      "type": "string",
      "description": "Notes column from the CSV."
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "Derived by scripts/structure.mjs from data/structure.json."
    },
    "children": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "description": "Inverse of parents (derived)."
    },
    "htmlOutline": {
      "type": "string",
      "minLength": 1,
      "description": "Illustrative semantic HTML skeleton (plain text, shown escaped). Follows the research's native HTML and ARIA guidance; not production markup."
    }
  }
}
